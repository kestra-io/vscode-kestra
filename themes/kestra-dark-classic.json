{
    "name": "kestra-dark-classic",
    "displayName": "Kestra Dark Classic",
    "type": "dark",
    "fg": "#D4D4D4",
    "bg": "#14181F",
    "colors": {
        "editor.background": "#14181F",
        "editor.foreground": "#D4D4D4",
        "editor.lineHighlightBackground": "#20232D",
        "editor.lineHighlightBorder": "#20232D",
        "editor.selectionBackground": "#264F78",
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editor.selectionHighlightBackground": "#ADD6FF26",
        "editor.wordHighlightBackground": "#ADD6FF26",
        "editor.wordHighlightStrongBackground": "#ADD6FF26",
        "editor.findMatchBackground": "#515C6A",
        "editor.findMatchHighlightBackground": "#EA5C0055",
        "editorCursor.foreground": "#AEAFAD",
        "editorLineNumber.foreground": "#9797A6",
        "editorLineNumber.activeForeground": "#CFD3D6",
        "editorIndentGuide.background1": "#2F3342",
        "editorIndentGuide.activeBackground1": "#404559",
        "editorWhitespace.foreground": "#404559",
        "editorBracketMatch.background": "#0064001A",
        "editorBracketMatch.border": "#404559",
        "editorBracketHighlight.foreground1": "#3DC9B0",
        "editorBracketHighlight.foreground2": "#4EC9B0",
        "editorBracketHighlight.foreground3": "#B5CEA8",
        "editorGutter.background": "#14181F",
        "editorStickyScroll.background": "#14181F",
        "minimap.background": "#14181F",
        "editorWidget.background": "#1E202A",
        "editorWidget.border": "#2C303F",
        "editorSuggestWidget.background": "#1E202A",
        "editorSuggestWidget.border": "#2C303F",
        "editorSuggestWidget.foreground": "#D4D4D4",
        "editorSuggestWidget.highlightForeground": "#3DC9B0",
        "editorSuggestWidget.selectedBackground": "#264F78",
        "editorHoverWidget.background": "#1E202A",
        "editorHoverWidget.border": "#2C303F",
        "editorLink.activeForeground": "#9CDCFE",
        "editorCodeLens.foreground": "#6A9955",
        "editorError.foreground": "#F14C4C",
        "editorWarning.foreground": "#CCA700",
        "editorInfo.foreground": "#3794FF",
        "scrollbarSlider.background": "#79797966",
        "scrollbarSlider.hoverBackground": "#646464B3",
        "scrollbarSlider.activeBackground": "#646464B3",
        "diffEditor.insertedLineBackground": "#029E734D",
        "diffEditor.removedLineBackground": "#FF000033",
        "diffEditor.insertedTextBackground": "#00000000",
        "editorGroupHeader.tabsBackground": "#1E202A",
        "editorGroupHeader.tabsBorder": "#2C303F",
        "tab.activeBackground": "#14181F",
        "tab.activeForeground": "#D4D4D4",
        "tab.activeBorderTop": "#3DC9B0",
        "titleBar.activeBackground": "#1E202A",
        "titleBar.activeForeground": "#9797A6",
        "titleBar.border": "#2C303F",
        "terminal.background": "#14181F",
        "focusBorder": "#AEAFAD"
    },
    "tokenColors": [
        {
            "settings": {
                "foreground": "#D4D4D4",
                "background": "#14181F"
            }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#6A9955",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "markup.inline.raw",
                "markup.fenced_code.block",
                "markup.raw"
            ],
            "settings": {
                "foreground": "#CE9178"
            }
        },
        {
            "scope": [
                "constant.character",
                "constant.character.escape",
                "constant.other.placeholder",
                "string.regexp constant.character.escape"
            ],
            "settings": {
                "foreground": "#D7BA7D"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.numeric",
                "keyword.other.unit",
                "constant.other.timestamp.yaml"
            ],
            "settings": {
                "foreground": "#B5CEA8"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language",
                "constant.other.boolean",
                "support.constant",
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "keyword",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.logical",
                "punctuation.accessor",
                "keyword.operator.pipe.shell",
                "keyword.operator.redirect.shell"
            ],
            "settings": {
                "foreground": "#D4D4D4"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.definition.tag",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.block.sequence.item.yaml",
                "punctuation.separator.key-value.mapping.yaml",
                "punctuation.definition.document.yaml",
                "entity.other.document.begin.yaml",
                "entity.other.document.end.yaml",
                "keyword.control.flow.block-scalar",
                "storage.modifier.chomping-indicator.yaml"
            ],
            "settings": {
                "foreground": "#D4D4D4"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "storage.type.java",
                "storage.type.generic.java",
                "entity.name.type.module"
            ],
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function",
                "meta.function-call.generic",
                "entity.name.command",
                "support.function.command"
            ],
            "settings": {
                "foreground": "#DCDCAA"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        {
            "scope": [
                "support.variable",
                "variable.language",
                "support.function.builtin",
                "support.function.builtin.shell",
                "variable.other.special",
                "variable.parameter.positional",
                "support.type.builtin"
            ],
            "settings": {
                "foreground": "#4FC1FF"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        {
            "scope": [
                "meta.decorator",
                "meta.annotation",
                "storage.type.annotation",
                "punctuation.definition.annotation",
                "entity.name.function.decorator",
                "meta.directive",
                "keyword.other.directive",
                "entity.name.tag.directive.yaml",
                "storage.type.tag-handle.yaml"
            ],
            "settings": {
                "foreground": "#DCDCAA"
            }
        },
        {
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#D16969"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.package",
                "storage.modifier.package",
                "storage.modifier.import",
                "entity.name.type.anchor.yaml",
                "variable.other.alias.yaml",
                "punctuation.definition.anchor.yaml",
                "punctuation.definition.alias.yaml",
                "keyword.control.flow.alias.yaml",
                "keyword.control.flow.anchor.yaml"
            ],
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section",
                "punctuation.definition.heading",
                "markup.heading.setext"
            ],
            "settings": {
                "foreground": "#569CD6",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "markup.link"
            ],
            "settings": {
                "foreground": "#9CDCFE",
                "fontStyle": "underline"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#6A9955",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.deleted",
                "punctuation.definition.deleted"
            ],
            "settings": {
                "foreground": "#F44747"
            }
        },
        {
            "scope": [
                "markup.inserted",
                "punctuation.definition.inserted"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#B5CEA8"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#F44747"
            }
        },
        {
            "scope": [
                "entity.name.tag.yaml",
                "support.type.property-name",
                "meta.object-literal.key",
                "keyword.other.definition.ini",
                "entity.name.tag.toml",
                "variable.other.key.toml",
                "support.type.property-name.json",
                "variable.declaration.hcl",
                "variable.other.declaration.hcl",
                "entity.name.label"
            ],
            "settings": {
                "foreground": "#3DC9B0"
            }
        },
        {
            "scope": [
                "string.unquoted.plain.out.yaml",
                "string.unquoted.plain.in.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.yaml",
                "string.unquoted.block.yaml",
                "string.quoted.double.json",
                "punctuation.definition.string.begin.yaml",
                "punctuation.definition.string.end.yaml",
                "punctuation.definition.string.begin.json",
                "punctuation.definition.string.end.json"
            ],
            "settings": {
                "foreground": "#CE9178"
            }
        },
        {
            "scope": [
                "constant.language.boolean.yaml",
                "constant.language.null.yaml",
                "constant.language.json"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "meta.embedded.expression.pebble",
                "meta.embedded.statement.pebble",
                "punctuation.section.tag.twig"
            ],
            "settings": {
                "foreground": "#FFCA16"
            }
        },
        {
            "scope": [
                "markup.italic",
                "emphasis"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.bold",
                "strong"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        }
    ]
}
